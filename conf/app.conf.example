# 切记不要使用单引号, 只能使用双引号或者不使用引号, 注释需要单独一行
appname = binance_futures
# zh, en
language = zh
log = 1
debug = 0

# 0: Emergency
# 1: Alert
# 2: Critical
# 3: Error
# 4: Warning
# 5: Notice
# 6: Informational
# 7: Debug
log_level = 6

[binance]
api_key = ""
api_secret = ""
# Binance HTTP/WebSocket SOCKS5 代理，不需要时留空；多个代理使用英文逗号分隔并轮询使用
# 支持 socks5:// 与 socks5h://，可使用 socks5://user:password@host:port
proxy_url = ""

[database]
# mysql
driver = "mysql"
username = ""
password = ""
host= ""
port= ""
dbname = ""
# 远程 MySQL 连接稳定性与连接池
connect_timeout_seconds = 5
read_timeout_seconds = 30
write_timeout_seconds = 30
max_open_conns = 30
max_idle_conns = 10
conn_max_lifetime_seconds = 300
conn_max_idle_time_seconds = 60

# sqlite
# driver = "sqlite"
# path = "./db/coin.db?_journal_mode=WAL&_busy_timeout=5000"

[ws]
# 使用 ws 管理仓位和订单，代替 http api，可有效避免 binance api 超限，需要本地网络稳定
futures_user_data = 1

[web]
# web端口
port = 3333
# 首页 path(不要修改这项，否则前端需要修改打包配置，重新打包)
index = zmkm
# jwt key
secret_key = ak4758
# 用户名
username = admin
# 密码
password = admin
# 过期时间(hour)
expires = 24
# 重启服务按钮命令
commend_start = pm2 restart go_binance_futures
# 停止合约服务命令
commend_stop = pm2 stop go_binance_futures
# 查看 web 日志的命令 /pm2-log
commend_log = pm2 log go_binance_futures

[notification]
# dingding, slack
channel = dingding

# 此处是全局配置，也可以在【首页->通知配置】页面进行各个模块的独立配置覆盖全局
[dingding]
# token
dingding_token = ""
# 触发关键词
dingding_word = "报警"

[slack]
slack_token = ""
slack_channel_id = ""

[external]
# 外部链接
links = [{"url": "url1", "title": "title1"}]

[mcp]
# MCP 仅使用 Streamable HTTP，地址为当前 Web 服务的 /mcp，使用登录接口返回的 Bearer Token 鉴权
mcp_server_enable = 0
# 第三方 MCP Interactive OAuth 本地开发地址。生产接 Binance 等远端 OAuth Provider 时必须改成公网 HTTPS。
oauth_public_base_url = "http://127.0.0.1:3333"
# 仅供本地开发的固定 32-byte AES-GCM key；生产必须替换并长期保存。
oauth_encryption_key = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
