# 切记不要使用单引号, 只能使用双引号或者不使用引号, 注释需要单独一行
appname = binance_futures
# zh, en
language = zh
log = 1
debug = 0

# 0: Emergency
# 1: Alert
# 2: Critical
# 3: Error
# 4: Warning
# 5: Notice
# 6: Informational
# 7: Debug
log_level = 6

[binance]
# 用于 交易 和 获取币安官方新闻
api_key = ""
api_secret = ""

# 开启以下配置会使用合约模拟交易代替真实交易
testnet = false
testnet_binance_futures_base_url = "https://testnet.binancefuture.com"
testnet_api_key = ""
testnet_api_secret = ""

# 独立的 Binance Spot 测试网配置；不能使用上面的 Futures Testnet 密钥
# SDK 自动拼接 /api/v3 路径，这里只填 REST 主机，不加 /api
testnet_binance_spot_base_url = "https://testnet.binance.vision"
testnet_spot_api_key = ""
testnet_spot_api_secret = ""

# Binance HTTP/WebSocket SOCKS5 代理，不需要时留空；多个代理使用英文逗号分隔并轮询使用
# 支持 socks5:// 与 socks5h://，可使用 socks5://user:password@host:port
proxy_url = ""

# Binance Public Data ZIP 缓存根目录；Adaptive 日级 ZIP 跨回测复用，超限按 LRU 清理
public_data_cache_dir = "./cache/tmp"
# 高精度 ZIP 缓存容量上限，单位 GiB，默认 10；运行中的回测不受配置修改影响
public_data_cache_max_gb = 10

[database]
# mysql
driver = "mysql"
username = ""
password = ""
host= ""
port= ""
dbname = ""

# MySQL 5.6+ 兼容；MySQL 8.0 如有需要可改为 utf8mb4_0900_ai_ci
collation = "utf8mb4_unicode_ci"
# 远程 MySQL 连接稳定性与连接池
connect_timeout_seconds = 5
read_timeout_seconds = 30
write_timeout_seconds = 30
max_open_conns = 30
max_idle_conns = 10
conn_max_lifetime_seconds = 300
conn_max_idle_time_seconds = 60

# sqlite
# driver = "sqlite"
# path = "./db/coin.db?_journal_mode=WAL&_busy_timeout=5000"

[web]
# web端口
port = 3333
# 首页 path(不要修改这项，否则前端需要修改打包配置，重新打包)
index = zmkm
# jwt key
secret_key = ak4758
# 用户名
username = admin
# 密码
password = admin
# 过期时间(hour)
expires = 24

[notification]
# dingding, slack
channel = dingding

# 此处是全局配置，也可以在【首页->通知配置】页面进行各个模块的独立配置覆盖全局
[dingding]
# token
dingding_token = ""
# 触发关键词
dingding_word = "报警"

[slack]
slack_token = ""
slack_channel_id = ""

[agent_skills]
# 标准 Agent Skills 持久化目录
data_dir = "./data/agent-skills"
# 服务器目录导入只允许访问此目录下的相对路径
import_dir = "./data/agent-skill-imports"

[mcp]
# MCP 仅使用 Streamable HTTP，地址为当前 Web 服务的 /mcp，使用登录接口返回的 Bearer Token 鉴权
mcp_server_enable = 0
# 第三方 MCP Interactive OAuth 本地开发地址。生产接 Binance 等远端 OAuth Provider 时必须改成公网 HTTPS。
oauth_public_base_url = "http://127.0.0.1:3333"
# 仅供本地开发的固定 32-byte AES-GCM key；生产必须替换并长期保存。
oauth_encryption_key = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"

[external]
# 外部链接
links = [{"url": "url1", "title": "title1"}]

